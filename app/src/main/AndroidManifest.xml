<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 側載用：讀取目前預設付款 App 的名稱（PackageManager） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <queries>
        <intent><action android:name="android.settings.NFC_PAYMENT_SETTINGS" /></intent>
        <intent><action android:name="android.settings.NFC_SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIRELESS_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <package android:name="com.finshell.wallet" />
        <package android:name="com.coloros.wallet" />
        <package android:name="com.heytap.wallet" />
        <package android:name="com.google.android.apps.walletnfcrel" />
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NfcSwitch">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 不可設 noHistory：要等系統設定頁回來後再讀目前預設、更新小工具 -->
        <activity
            android:name=".PaySettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="tw.nfcswitch.settings"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".widget.NfcSwitchWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nfc_switch_widget_info" />
        </receiver>

        <service
            android:name=".tile.NfcSwitchTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
